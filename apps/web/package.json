{
  "name": "@kridoc/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:code-names": "krizaka-code-names messages",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "auth:create-admin": "esbuild scripts/create-admin.mts --bundle --platform=node --format=esm '--external:@krizaka/*' --external:pg --external:zod --log-level=warning --outfile=node_modules/.cache/create-admin.mjs && node node_modules/.cache/create-admin.mjs",
    "storage:types": "esbuild scripts/storage-api-types.mts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/storage-api-types.mjs && node node_modules/.cache/storage-api-types.mjs",
    "storage:client": "esbuild scripts/storage-client.mts --bundle --platform=node --format=esm '--external:@krizaka/*' --external:pg --external:zod --log-level=warning --outfile=node_modules/.cache/storage-client.mjs && node node_modules/.cache/storage-client.mjs",
    "storage:sweep": "esbuild scripts/storage-sweep.mts --bundle --platform=node --format=esm '--external:@krizaka/*' --external:pg --external:zod --log-level=warning --outfile=node_modules/.cache/storage-sweep.mjs && node node_modules/.cache/storage-sweep.mjs",
    "db:rebuild": "esbuild scripts/db-rebuild.mts --bundle --platform=node --format=esm '--external:@krizaka/*' --external:pg --external:zod --log-level=warning --outfile=node_modules/.cache/db-rebuild.mjs && node node_modules/.cache/db-rebuild.mjs"
  },
  "dependencies": {
    "@krizaka/audit": "^0.1.8",
    "@krizaka/auth": "^0.14.0",
    "@krizaka/db": "0.3.1",
    "@krizaka/fonts": "0.5.4",
    "@krizaka/i18n": "^0.2.4",
    "@krizaka/icons": "^0.11.0",
    "@krizaka/org": "^1.12.0",
    "@krizaka/query": "^0.3.0",
    "@krizaka/rate-limit": "^0.3.1",
    "@krizaka/settings": "^0.7.1",
    "@krizaka/storage": "^0.13.0",
    "@krizaka/tailwind": "^4.16.0",
    "@krizaka/time": "^0.2.0",
    "@krizaka/tokens": "^4.16.0",
    "@krizaka/ui": "^4.16.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@krizaka/config": "^0.25.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.6",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
