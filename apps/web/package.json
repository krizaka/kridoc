{
  "name": "@kridoc/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:code-names": "krizaka-code-names messages",
    "test": "vitest run --coverage",
    "db:rebuild": "esbuild scripts/db-rebuild.mts --bundle --platform=node --format=esm '--external:@krizaka/*' --external:pg --external:zod --log-level=warning --outfile=node_modules/.cache/db-rebuild.mjs && node node_modules/.cache/db-rebuild.mjs"
  },
  "dependencies": {
    "@krizaka/db": "0.3.1",
    "@krizaka/fonts": "0.5.4",
    "@krizaka/i18n": "^0.2.4",
    "@krizaka/icons": "^0.10.0",
    "@krizaka/org": "^1.5.0",
    "@krizaka/query": "^0.3.0",
    "@krizaka/tailwind": "^4.7.0",
    "@krizaka/time": "^0.2.0",
    "@krizaka/tokens": "^4.7.0",
    "@krizaka/ui": "^4.7.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@krizaka/config": "^0.25.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
