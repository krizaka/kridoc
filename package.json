{
  "name": "kridoc-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Kridoc — started from krizaka/template-next-app.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev --filter=@kridoc/web",
    "build": "turbo run build",
    "lint:workspace": "npx --yes -p @krizaka/config@latest krizaka-workspace-guard",
    "lint": "pnpm run lint:workspace && turbo run lint && pnpm run check:i18n && krizaka-sg-ratchet && pnpm run format:check",
    "check:i18n": "krizaka-i18n check apps/web/messages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run && node --test --test-timeout=120000 --test-force-exit scripts/check-template-drift.test.mjs scripts/promote-production.test.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "drift": "node scripts/check-template-drift.mjs",
    "seo:check": "krizaka-seo-family --base http://localhost:3000 --host https://www.kridoc.com --types WebSite",
    "lint:sg": "krizaka-sg-ratchet",
    "sg:ratchet:update": "krizaka-sg-ratchet --update",
    "sg:fix": "node scripts/sg-fix.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "db:rebuild": "pnpm --filter @kridoc/web db:rebuild"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/config": "^0.25.0",
    "@krizaka/i18n": "^0.2.4",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "FSL-1.1-ALv2",
  "author": "Krizaka"
}
